# ===========================================================================
# COPIE ESTE ARQUIVO PARA .env.local E PREENCHA OS VALORES
# (no Vercel, cadastre as mesmas variáveis em Settings > Environment Variables)
# ===========================================================================

# --- Supabase ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (SECRETA - só usada no servidor, nunca no navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Sessão (login por email) ---
# Segredo para assinar o cookie de login. Gere um valor longo e aleatório.
# Ex (PowerShell):  [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
SESSION_SECRET=troque-por-um-valor-aleatorio-bem-longo

# --- Webhook ---
# Token compartilhado para validar que o POST veio mesmo do seu gateway.
# Você vai configurar a URL do webhook assim:
#   https://SEU-SITE.vercel.app/api/webhook/vega?token=ESTE_VALOR
#   https://SEU-SITE.vercel.app/api/webhook/ggcheckout?token=ESTE_VALOR
WEBHOOK_SECRET=troque-por-outro-valor-aleatorio
